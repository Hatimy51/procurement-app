# Copy this file to a new file named ".env" (no ".example") in the same
# folder, then fill in your real key below. The ".env" file is intentionally
# excluded from GitHub (see .gitignore) so your key never gets published,
# even accidentally, even to a private repo.

GROQ_API_KEY=your_key_here

# Gmail inbox connection (see the Inbox setup guide) — leave these blank
# if you're not connecting an inbox yet.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_key_here
# ERP / Accounting integrations
ZOHO_API_KEY=
ZOHO_ORG_ID=
TALLY_URL=http://localhost:9000

VENDOR_SESSION_HOURS=8
VENDOR_UPLOAD_MAX_BYTES=10485760
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000